# ─── Telegram Bot Config ───────────────────────────────────────────────────
# Get BOT_TOKEN from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram chat ID (get it by messaging @userinfobot)
# For multiple admins, comma-separate: 123456789,987654321
ALLOWED_CHAT_IDS=your_chat_id_here
